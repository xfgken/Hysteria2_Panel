[Unit]
Description=Hysteria 2 Server (official core)
Documentation=https://v2.hysteria.network/
After=network.target nss-lookup.target

[Service]
Type=simple
# 工作目录与配置路径需与 /opt/hy2-panel 布局一致
WorkingDirectory=/opt/hy2-panel
ExecStart=/usr/local/bin/hysteria server -c /opt/hy2-panel/config/hysteria.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

# 端口跳跃 / 绑定低端口所需的能力
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# 切勿限制 CapabilityBoundingSet：
# 一旦把 CAP_DAC_OVERRIDE / CAP_DAC_READ_SEARCH 排除在外，root 将无法读取
# 属主为 hy2-panel、权限 0600 的配置文件，服务会以
# "failed to read server config: permission denied" 反复重启失败。
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target